<h1>Folder Management</h1>

<!-- CREATE FOLDER -->
<h2>Create Folder</h2>
<%= form_with(model: @folder, local: true) do |f| %>
  <div>
    <%= f.label :name, "Folder Name" %>
    <%= f.text_field :name, required: true %>
    <%= f.submit "Create Folder" %>
  </div>
<% end %>

<hr>

<!-- SEE FOLDERS -->
<h2>Active Folders</h2>
<ul>
  <% @folders.each do |folder| %>
    <li style="margin-bottom: 15px;">
      <!-- SEE -->
      <strong><%= link_to folder.name, folder_path(folder) %></strong>
      (<%= folder.documents.count %> documents)

      <!-- RENAME -->
      <%= form_with(model: folder, local: true, style: "display: inline-block; margin-left: 10px;") do |f| %>
        <%= f.text_field :name, value: folder.name, style: "width: 150px;" %>
        <%= f.submit "Rename" %>
      <% end %>

      <!-- ARCHIVE -->
      <%= button_to "Archive", archive_folder_path(folder), method: :patch, data: { confirm: "Archive this folder?" }, style: "display: inline-block; margin-left: 5px;" %>
    </li>
  <% end %>
</ul>