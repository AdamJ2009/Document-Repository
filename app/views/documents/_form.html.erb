<%= form_with model: document do |form| %>
  <% if document.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(document.errors.count, "error") %> prohibited this document from being saved:</h2>
      <ul>
        <% document.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :file %>
    <%= form.file_field :file %>
  </div>

  <!-- Accessibility Level: Admins pick options, non-admins default to 0 -->
  <% if Current.user&.admin? %>
    <div>
      <%= form.label :accessibility_level, "Accessibility Level" %>
      <%= form.select :accessibility_level, [
        ["Public (Not Logged In)", "public_access"],
        ["Logged In Users Only", "logged_in"],
        ["Admin Only", "admin_only"]
      ] %>
    </div>
  <% else %>
    <%= form.hidden_field :accessibility_level, value: 0 %>
  <% end %>

  <!-- Importance Flag: Available to all users -->
  <div>
    <%= form.label :importance_flag, "Importance" %>
    <%= form.select :importance_flag, [
      ["Normal", "normal"],
      ["Important", "important"]
    ] %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>