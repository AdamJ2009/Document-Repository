<h1>Documents</h1>

<%= link_to "New document", new_document_path if authenticated? %>
<%= link_to "Login", new_session_path unless authenticated? %>

<ul>
  <% @documents.each do |document| %>
    <li>
      <%= link_to document.title, document_path(document) %>

      <%# Display Important badge %>
      <% if document.importance_important? %>
        <span style="color: gold; font-weight: bold;">[★ Important]</span>
      <% end %>

      <%# Display Admin Only tag %>
      <% if document.access_admin_only? %>
        <span style="color: red;">(Admin Only)</span>
      <% end %>
    </li>
  <% end %>
</ul>