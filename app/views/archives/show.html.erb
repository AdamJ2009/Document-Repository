<% if Current.user&.admin? %>
  <h1><%= @archive.title %></h1>

  <div>
    <% if @archive.file.attached? %>
      <%= link_to "Download File (#{@archive.file.filename})", url_for(@archive.file) %>
      
      <%# Display file upload timestamp %>
      <p>
        <strong>Uploaded:</strong> 
        <%= @archive.file.created_at.strftime("%B %d, %Y at %I:%M %p") %> 
        (<%= time_ago_in_words(@archive.file.created_at) %> ago)
      </p>
    <% else %>
      <p>No file attached.</p>
    <% end %>
  </div>

  <p><%= link_to "Back to Archive", archives_path %></p>
<% else %>
  <p style="color: red;">Access Denied: You must be an admin to view this archive.</p>
  <p><%= link_to "Return to Home", root_path %></p>
<% end %>